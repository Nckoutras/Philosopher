openapi.json

# --- §8.2 eval harness run output ---
# manifest.json and summary.csv ARE committable — they are what a finding cites.
# The raw completions and the per-row scores are generated, large, and full of
# model output; `python -m evals.run --rescore <dir>` regenerates scores.csv from
# completions.jsonl for free, so neither needs to be in git.
apps/api/evals/results/**/completions.jsonl
apps/api/evals/results/**/scores.csv

# Founder's local copy of an external teardown; held elsewhere, not repo content.
# Narrow on purpose: 14 files in docs/reports/ ARE tracked, so the directory
# must not be ignored — only this one path.
docs/reports/The-Wise-Room-Teardown_2026-08-25.html
