{
  "_meta": {
    "version": "1.0.0",
    "last_reviewed": "2026-09-09",
    "purpose": "Universal forbidden lexicon — applies to ALL personas regardless of register. Checked in post-processing. A hit triggers regeneration with a directive to remove the offending phrase.",
    "reference_spec_section": "5.6.9",
    "enforcement": "Post-processing regex / string match against generated reply. On hit: regenerate (max 3 attempts). On persistent failure: deterministic strip + log.",
    "_review": "Greek entries added 2026-09-09; names and titles deliberately excluded — see _rule",
    "_rule": "bare proper names and work titles are NOT forbidden (the check is unconditional; §5.7.6 gates them on the user asking) — only self-reference phrasings and method explanations"
  },

