  "_meta_implementation": {
    "check_order": "Run categories in order: ai_tells → emoji → modern_brands → modern_slang → therapy_jargon → self_help_platitudes → throat_clearing → summary_of_user → list_formatting → closing_flourishes → hedging_filler → ai_safety_overcaveat",

    "first_hit_action": "On first regeneration, instruct the model to remove the specific phrase/pattern that hit. Do not add new content.",

    "second_hit_action": "On second regeneration, tighten the brevity instruction in addition to removing the offending phrase.",

    "third_hit_action": "On third failure, deterministically strip the offending content and send the trimmed version. Log the failure for prompt engineering review.",

    "false_positive_management": "If a hit is in retrieved RAG content (i.e., the user has quoted a passage that contains a forbidden phrase), the orchestration layer marks it as cited content and exempts. The persona's OWN generation is what is checked.",

    "user_input_exemption": "Forbidden phrases in USER input are not blocked. The map applies to assistant output only."
  }
}
